    def load_locale_descriptions(self):
        """Load locale descriptions"""
        descriptions = {}
        try:
            list_path = Path("/usr/local/locale-essora/list.txt")
            if list_path.exists():
                with list_path.open() as f:
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith('#'):
                            parts = line.split('#', 1)
                            if len(parts) == 2:
                                locale = parts[0].strip()
                                description = parts[1].strip()
                                descriptions[locale] = description
            
            with open('/usr/share/i18n/SUPPORTED') as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith('#'):
                        locale = line.split()[0]
                        if locale.endswith('.UTF-8') and locale not in descriptions:
                            descriptions[locale] = locale
        except Exception as e:
            print(f"Error loading locale descriptions: {e}")
        return descriptions
    
    def ensure_locale_symlink(self):
        """Ensure /etc/default/locale symlink exists"""
        default_locale = Path("/etc/default/locale")
        if not default_locale.exists():
            try:
                self.run_as_root(['ln', '-s', '/etc/locale.conf', '/etc/default/locale'])
            except Exception as e:
                self.log_error(f"Error creating symlink: {e}")
    
    def load_locale_settings(self):
        """Load locale settings"""
        settings = {}
        try:
            if self.locale_conf.exists():
                with self.locale_conf.open() as f:
                    for line in f:
                        line = line.strip()
                        if line and '=' in line and not line.startswith('#'):
                            key, value = line.split('=', 1)
                            settings[key.strip()] = value.strip(' "\'')
            
            if 'LANG' not in settings:
                result = subprocess.run(['locale'], capture_output=True, text=True)
                for line in result.stdout.split('\n'):
                    if line.startswith('LANG='):
                        settings['LANG'] = line.split('=', 1)[1].strip(' "\'')
                        break
        except Exception as e:
            print(f"Error loading locale settings: {e}")
        
        if 'LANG' not in settings:
            settings['LANG'] = 'Not set'
        
        return settings
    
    def load_keyboard_settings(self):
        """Load keyboard settings"""
        settings = {
            'XKBMODEL': 'pc105',
            'XKBLAYOUT': 'us',
            'XKBVARIANT': '',
            'XKBOPTIONS': ''
        }
        
        try:
            if self.keyboard_config.exists():
                with self.keyboard_config.open() as f:
                    for line in f:
                        line = line.strip()
                        if line and '=' in line and not line.startswith('#'):
                            key, value = line.split('=', 1)
                            settings[key.strip()] = value.strip(' "\'')
        except Exception as e:
            print(f"Error loading keyboard settings: {e}")
        
        return settings
    
    def load_environment_settings(self):
        """Load environment settings"""
        settings = {}
        try:
            if self.environment_file.exists():
                with self.environment_file.open() as f:
                    for line in f:
                        line = line.strip()
                        if line and '=' in line and not line.startswith('#'):
                            key, value = line.split('=', 1)
                            key = key.strip()
                            if not key.startswith('LANG') and not key.startswith('LC_'):
                                settings[key] = value.strip(' "\'')
        except Exception as e:
            print(f"Error loading environment settings: {e}")
        
        return settings
    
    def get_current_timezone(self):
        """Get current timezone"""
        try:
            if self.timezone_file.exists():
                with self.timezone_file.open() as f:
                    return f.read().strip()
        except:
            pass
        
        try:
            result = subprocess.run(['timedatectl', 'show', '-p', 'Timezone', '--value'],
                                  capture_output=True, text=True)
            if result.returncode == 0:
                return result.stdout.strip()
        except:
            pass
        
        return 'UTC'
    
    def update_display(self):
        """Update display with current settings"""
        # Language
        current_lang = self.current_settings.get('LANG', 'Not set')
        display_text = current_lang
        if current_lang != 'Not set' and current_lang in self.locale_descriptions:
            display_text += f" ({self.locale_descriptions[current_lang]})"
        self.lang_value.set_text(display_text)
        
        # Keyboard
        self.kb_layout_value.set_text(self.keyboard_settings.get('XKBLAYOUT', 'Not set'))
        self.kb_model_value.set_text(self.keyboard_settings.get('XKBMODEL', 'Not set'))
        
        # Timezone
        self.tz_value.set_text(self.current_timezone)
    
    def change_system_lang(self):
        """Show dialog to change system language"""
        dialog = Gtk.Dialog(title=_("Select System Language"), parent=self, flags=0)
        dialog.set_default_size(700, 500)
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OK, Gtk.ResponseType.OK
        )
        
        box = dialog.get_content_area()
        box.set_spacing(10)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_start(10)
        box.set_margin_end(10)
        
        # Search entry
        search_entry = Gtk.SearchEntry()
        search_entry.set_placeholder_text(_("Search languages..."))
        box.pack_start(search_entry, False, False, 0)
        
        # Scrolled window
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_min_content_height(350)
        box.pack_start(scrolled, True, True, 0)
        
        # TreeView
        liststore = Gtk.ListStore(str, str)
        treeview = Gtk.TreeView(model=liststore)
        
        # Locale column
        renderer = Gtk.CellRendererText()
        column = Gtk.TreeViewColumn(_("Locale"), renderer, text=0)
        column.set_sort_column_id(0)
        treeview.append_column(column)
        
        # Description column
        renderer2 = Gtk.CellRendererText()
        column2 = Gtk.TreeViewColumn(_("Description"), renderer2, text=1)
        column2.set_sort_column_id(1)
        treeview.append_column(column2)
        
        scrolled.add(treeview)
        
        # Populate list
        locales = sorted(self.locale_descriptions.items())
        for locale, description in locales:
            liststore.append([locale, description])
        
        # Search function
        def on_search_changed(entry):
            search_text = entry.get_text().lower()
            liststore.clear()
            for locale, description in locales:
                if search_text in locale.lower() or search_text in description.lower():
                    liststore.append([locale, description])
        
        search_entry.connect("search-changed", on_search_changed)
        
        dialog.show_all()
        response = dialog.run()
        
        if response == Gtk.ResponseType.OK:
            selection = treeview.get_selection()
            model, treeiter = selection.get_selected()
            if treeiter:
                selected_locale = model[treeiter][0]
                self.current_settings['LANG'] = selected_locale
                for key in ['LC_ALL', 'LC_ADDRESS', 'LC_IDENTIFICATION', 'LC_MEASUREMENT',
                           'LC_MONETARY', 'LC_NAME', 'LC_NUMERIC', 'LC_PAPER',
                           'LC_TELEPHONE', 'LC_TIME']:
                    self.current_settings[key] = selected_locale
                self.update_display()
                self.log_output(_("Language changed to: {locale}").format(locale=selected_locale))
        
        dialog.destroy()
    
