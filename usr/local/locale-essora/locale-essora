            search_text = entry.get_text().lower()
            liststore.clear()
            for model in sorted(models):
                if search_text in model.lower():
                    liststore.append([model])
        
        search_entry.connect("search-changed", on_search_changed)
        
        dialog.show_all()
        response = dialog.run()
        
        if response == Gtk.ResponseType.OK:
            selection = treeview.get_selection()
            model, treeiter = selection.get_selected()
            if treeiter:
                selected_model = model[treeiter][0]
                self.keyboard_settings['XKBMODEL'] = selected_model
                self.update_display()
                self.log_output(_("Keyboard model changed to: {model}").format(model=selected_model))
        
        dialog.destroy()
    
    def change_timezone(self):
        """Show dialog to change timezone"""
        dialog = Gtk.Dialog(title=_("Select Timezone"), parent=self, flags=0)
        dialog.set_default_size(600, 500)
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OK, Gtk.ResponseType.OK
        )
        
        box = dialog.get_content_area()
        box.set_spacing(10)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_start(10)
        box.set_margin_end(10)
        
        # Search entry
        search_entry = Gtk.SearchEntry()
        search_entry.set_placeholder_text(_("Search timezones..."))
        box.pack_start(search_entry, False, False, 0)
        
        # Scrolled window
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_min_content_height(350)
        box.pack_start(scrolled, True, True, 0)
        
        # TreeView
        liststore = Gtk.ListStore(str)
        treeview = Gtk.TreeView(model=liststore)
        treeview.set_headers_visible(True)
        
        renderer = Gtk.CellRendererText()
        column = Gtk.TreeViewColumn(_("Timezone"), renderer, text=0)
        treeview.append_column(column)
        
        scrolled.add(treeview)
        
        # Get timezones
        timezones = self.get_timezones()
        for tz in sorted(timezones):
            liststore.append([tz])
        
        # Search function
        def on_search_changed(entry):
            search_text = entry.get_text().lower()
            liststore.clear()
            for tz in sorted(timezones):
                if search_text in tz.lower():
                    liststore.append([tz])
        
        search_entry.connect("search-changed", on_search_changed)
        
        dialog.show_all()
        response = dialog.run()
        
        if response == Gtk.ResponseType.OK:
            selection = treeview.get_selection()
            model, treeiter = selection.get_selected()
            if treeiter:
                selected_tz = model[treeiter][0]
                self.current_timezone = selected_tz
                self.update_display()
                self.log_output(_("Timezone changed to: {tz}").format(tz=selected_tz))
        
        dialog.destroy()
    
    def get_keyboard_layouts(self):
        """Get available keyboard layouts"""
        layouts = []
        try:
            result = subprocess.run(['localectl', 'list-x11-keymap-layouts'],
                                  capture_output=True, text=True, timeout=5)
            if result.returncode == 0:
                layouts = result.stdout.strip().split('\n')
        except:
            layouts = ['us', 'es', 'fr', 'de', 'it', 'pt', 'ru', 'uk', 'jp', 'cn']
        
        return [l for l in layouts if l]
    
    def get_keyboard_models(self):
        """Get available keyboard models"""
        models = []
        try:
            result = subprocess.run(['localectl', 'list-x11-keymap-models'],
                                  capture_output=True, text=True, timeout=5)
            if result.returncode == 0:
                models = result.stdout.strip().split('\n')
        except:
            models = ['pc105', 'pc104', 'pc101', 'macintosh']
        
        return [m for m in models if m]
    
    def get_timezones(self):
        """Get available timezones"""
        timezones = []
        try:
            result = subprocess.run(['timedatectl', 'list-timezones'],
                                  capture_output=True, text=True, timeout=5)
            if result.returncode == 0:
                timezones = result.stdout.strip().split('\n')
        except:
            zoneinfo_path = Path('/usr/share/zoneinfo')
            if zoneinfo_path.exists():
                for root, dirs, files in os.walk(zoneinfo_path):
                    dirs[:] = [d for d in dirs if d not in ['right', 'posix', 'SystemV', 'Etc']]
                    for file in files:
                        if file[0].isupper():
                            tz = os.path.join(root, file).replace(str(zoneinfo_path) + '/', '')
                            timezones.append(tz)
        
        return sorted([tz for tz in timezones if tz and '/' in tz])
    
    def log_output(self, message):
        """Log message to console"""
        end_iter = self.console_buffer.get_end_iter()
        self.console_buffer.insert(end_iter, message + "\n")
        
        mark = self.console_buffer.create_mark(None, end_iter, False)
        self.console_textview.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)
    
    def log_error(self, message):
        """Log error message"""
        self.log_output(f"ERROR: {message}")
    
    def run_as_root(self, command):
        """Run command as root"""
        try:
            result = subprocess.run(command, capture_output=True, text=True, check=True)
            if result.stdout:
                self.log_output(result.stdout)
            return True
        except subprocess.CalledProcessError as e:
            self.log_error(f"Command failed: {' '.join(command)}")
            if e.stderr:
                self.log_error(e.stderr)
            return False
        except Exception as e:
            self.log_error(f"Error running command: {e}")
            return False
    
    def generate_and_apply(self):
        """Generate locales and apply all settings"""
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text=_("Confirm Action")
        )
        dialog.format_secondary_text(
            _("This will generate locales and apply all settings. Continue?")
        )
        response = dialog.run()
        dialog.destroy()
        
        if response != Gtk.ResponseType.YES:
            return
        
        self.log_output(_("Generating locales..."))
        
        # Prepare locale.gen
        try:
            locale_gen_content = []
            if self.locale_gen.exists():
                with self.locale_gen.open() as f:
                    locale_gen_content = f.readlines()
            
            selected_locale = self.current_settings['LANG']
            new_content = []
            locale_found = False
            
            for line in locale_gen_content:
                stripped = line.strip()
                if stripped.startswith('#') and selected_locale in stripped:
                    new_content.append(stripped[1:] + '\n')
                    locale_found = True
                elif selected_locale in stripped and not stripped.startswith('#'):
                    new_content.append(line)
                    locale_found = True
                else:
                    new_content.append(line)
            
            if not locale_found:
                new_content.append(f"{selected_locale} UTF-8\n")
            
            with tempfile.NamedTemporaryFile(mode='w', delete=False) as tmp:
                tmp.writelines(new_content)
                self.temp_files.append(tmp.name)
            
            self.run_as_root(['cp', tmp.name, str(self.locale_gen)])
            
        except Exception as e:
            self.log_error(f"Error preparing locale.gen: {e}")
            return
        
        # Generate locales
        if not self.run_as_root(['locale-gen']):
            self.log_error(_("Failed to generate locales"))
            return
        
        # Apply locale settings
        self.log_output(_("Applying locale settings..."))
        try:
            with tempfile.NamedTemporaryFile(mode='w', delete=False) as tmp:
                for key, value in self.current_settings.items():
                    tmp.write(f'{key}="{value}"\n')
                self.temp_files.append(tmp.name)
            
            self.run_as_root(['cp', tmp.name, str(self.locale_conf)])
            
            # Update /etc/environment if enabled
            if self.env_switch.get_active():
                self.log_output(_("Updating /etc/environment..."))
                env_settings = self.environment_settings.copy()
                env_settings.update(self.current_settings)
                
                with tempfile.NamedTemporaryFile(mode='w', delete=False) as tmp:
                    for key, value in env_settings.items():
                        tmp.write(f'{key}="{value}"\n')
                    self.temp_files.append(tmp.name)
                
                self.run_as_root(['cp', tmp.name, str(self.environment_file)])
            
        except Exception as e:
            self.log_error(f"Error applying locale settings: {e}")
        
        # Apply keyboard settings
        self.log_output(_("Applying keyboard settings..."))
        try:
            with tempfile.NamedTemporaryFile(mode='w', delete=False) as tmp:
                for key, value in self.keyboard_settings.items():
                    tmp.write(f'{key}="{value}"\n')
                self.temp_files.append(tmp.name)
            
            self.run_as_root(['cp', tmp.name, str(self.keyboard_config)])
            
            try:
                self.run_as_root(['setupcon', '--keyboard-only', '--force'])
            except:
                pass
            
            # Configure X11
            try:
                xorg_conf = f"""Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "{self.keyboard_settings['XKBLAYOUT']}"
    Option "XkbModel" "{self.keyboard_settings['XKBMODEL']}"
EndSection
"""
                
                with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.conf') as tmp:
                    tmp.write(xorg_conf)
                    self.temp_files.append(tmp.name)
                
                self.run_as_root(['mkdir', '-p', '/etc/X11/xorg.conf.d'])
                self.run_as_root(['cp', tmp.name, '/etc/X11/xorg.conf.d/00-keyboard.conf'])
            except:
                pass
            
        except Exception as e:
            self.log_error(f"Error applying keyboard settings: {e}")
        
        # Apply timezone
        self.log_output(_("Applying timezone settings..."))
        try:
            with tempfile.NamedTemporaryFile(mode='w', delete=False) as tmp:
                tmp.write(self.current_timezone + '\n')
                self.temp_files.append(tmp.name)
            
            self.run_as_root(['cp', tmp.name, str(self.timezone_file)])
            
            zoneinfo_path = f"/usr/share/zoneinfo/{self.current_timezone}"
            if os.path.exists(zoneinfo_path):
                self.run_as_root(['ln', '-sf', zoneinfo_path, '/etc/localtime'])
            else:
                self.log_error(_("Timezone file not found: {zoneinfo_path}").format(
                    zoneinfo_path=zoneinfo_path))
            
        except Exception as e:
            self.log_error(f"Error applying timezone settings: {e}")
        
        # Success
        self.log_output(_("Settings applied successfully!"))
        self.log_output(_("You may need to restart your session for all changes to take effect."))
        
        done_dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text=_("Completed")
        )
        done_dialog.format_secondary_text(_("Settings applied. You can continue the installation."))
        done_dialog.run()
        done_dialog.destroy()

        self._force_quit = True
        try:
            self.close()
        except Exception:
            Gtk.main_quit()
    
    def on_close(self, *args):
        # If we are closing after Apply, quit silently
        if getattr(self, "_force_quit", False):
            try:
                Gtk.main_quit()
            except Exception:
                pass
            return False

        # Keep it simple: close without extra dialogs
        try:
            Gtk.main_quit()
        except Exception:
            pass
        return False

def main():
    app = EssoraLocaleGTK()
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
